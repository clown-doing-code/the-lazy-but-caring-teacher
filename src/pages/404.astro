    <p class="text-sm text-muted-foreground">404</p>
    <h1 class="font-heading text-3xl font-medium tracking-tight">
      Page not found
    </h1>
    <p class="max-w-prose text-muted-foreground">
      TODO: one line on what might have gone wrong, or just point them home.
    </p>
