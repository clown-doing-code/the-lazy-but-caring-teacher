---
import "@/styles/global.css"

import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"
import { SITE } from "@/config"
import { getAuthor } from "@/lib/authors"
import { withBase } from "@/lib/url"

interface Props {
  title?: string
  description?: string
  /** BCP 47 tag for the page's own language, e.g. "es". Drives <html lang>. */
  lang?: string
  ogType?: "website" | "article"
  publishedTime?: Date
  modifiedTime?: Date
  /** Overrides <meta name="author"> on pages with their own byline. */
  author?: string
  /** Absolute or root-relative URL for social previews. */
  ogImage?: string
  ogImageWidth?: number
  ogImageHeight?: number
  ogImageAlt?: string
  /**
   * The other renderings of this page, one per language. Emitted as hreflang
   * alternates so a search engine can pair the translations instead of
   * treating them as competing duplicates.
   */
  alternates?: { lang: string; href: string }[]
}

const {
  title,
  description = SITE.description,
  lang = "en",
  ogType = "website",
  publishedTime,
  modifiedTime,
  author,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  alternates = [],
} = Astro.props

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title
// Astro.url.pathname already includes `base`, so the canonical is correct
// under a subfolder deployment without extra handling.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url)
const metaAuthor = author ?? getAuthor(undefined).name
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={metaAuthor} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
      ))
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content={String(ogImageWidth)} />
          <meta property="og:image:height" content={String(ogImageHeight)} />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL(withBase("/rss.xml/"), Astro.site ?? SITE.url)}
    />

    <script is:inline>
      // Runs before paint so the theme never flashes.
      const stored = localStorage.getItem("theme")
      const isDark =
        stored === "dark" ||
        (stored !== "light" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      document.documentElement.classList.toggle("dark", isDark)
    </script>
  </head>
  <body class="flex min-h-svh flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-background focus:px-3 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-10">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
