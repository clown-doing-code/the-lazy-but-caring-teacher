---
import Pagination from "@/components/pagination.astro"
import PostCard from "@/components/post-card.astro"
import { groupByYear, paginatePosts, type Post } from "@/lib/posts"
import { withBase } from "@/lib/url"

interface Props {
  /** Every post, newest first, as returned by getPosts(). */
  posts: Post[]
  /** 1-based page to render. */
  pageNumber: number
}

const { posts, pageNumber } = Astro.props

const { posts: pagePosts, pageCount, total } = paginatePosts(posts, pageNumber)
// Grouped after slicing, so a year heading only appears on the pages that
// actually hold posts from it.
const years = groupByYear(pagePosts)
const firstShown = total === 0 ? 0 : (pageNumber - 1) * pagePosts.length + 1

// Page 1 lives at /posts/; the rest sit under /posts/page/. The static
// "page" segment keeps them clear of the posts/[...slug] route, so a post
// slug can never collide with a page number.
const pageHref = (page: number) =>
  page === 1 ? withBase("/posts/") : withBase(`/posts/page/${page}/`)
---

<section class="flex flex-col gap-8">
  <header class="flex flex-col gap-2">
    <h1 class="font-heading text-3xl font-medium tracking-tight">Posts</h1>
    <p class="text-muted-foreground">
      {
        total > 0
          ? `${total} ${total === 1 ? "post" : "posts"}, newest first.`
          : "TODO: nothing published yet."
      }
      {
        pageCount > 1 && (
          <span>
            {" "}
            Showing {firstShown}&ndash;{firstShown + pagePosts.length - 1}.
          </span>
        )
      }
    </p>
  </header>

  {
    pagePosts.length > 0 && (
      <div class="flex flex-col gap-10">
        {years.map(([year, yearPosts]) => (
          <section class="flex flex-col gap-4">
            <h2 class="font-heading text-sm font-medium text-muted-foreground">
              {year}
            </h2>
            <div class="grid gap-4">
              {yearPosts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }

  <Pagination
    pageNumber={pageNumber}
    pageCount={pageCount}
    pageHref={pageHref}
  />
</section>
