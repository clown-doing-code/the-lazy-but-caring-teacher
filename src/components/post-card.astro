---
import type { CollectionEntry } from "astro:content"

import { Badge } from "@/components/ui/badge"
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
} from "@/components/ui/card"
import { formatDate } from "@/lib/format"
import { withBase } from "@/lib/url"

interface Props {
  post: CollectionEntry<"posts">
}

const { post } = Astro.props
const href = withBase(`/posts/${post.id}/`)
---

<Card>
  <CardHeader>
    <h3 class="font-heading text-base font-medium">
      <a href={href} class="hover:underline">{post.data.title}</a>
    </h3>
    <CardDescription>{post.data.description}</CardDescription>
  </CardHeader>
  <CardFooter className="flex-row items-center justify-between gap-4">
    <time
      datetime={post.data.pubDate.toISOString()}
      class="text-muted-foreground"
    >
      {formatDate(post.data.pubDate)}
    </time>
    {
      post.data.tags.length > 0 && (
        <ul class="flex flex-wrap items-center gap-1">
          {post.data.tags.map((tag) => (
            <li>
              <Badge variant="secondary">{tag}</Badge>
            </li>
          ))}
        </ul>
      )
    }
  </CardFooter>
</Card>
